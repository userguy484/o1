local function ShowBadge(titleText, isSuccess)
    if closed or not ScreenGui.Parent then return end
    if not titleText then titleText = "" end
    isSuccess = not not isSuccess

    local Badge = Instance.new("Frame")
    Badge.Size = UDim2.new(0, 250, 0, 60)
    Badge.Position = UDim2.new(1, 20, 1, -80)
    Badge.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    Badge.BorderSizePixel = 0
    Badge.Parent = ScreenGui

    Instance.new("UICorner", Badge).CornerRadius = UDim.new(0, 6)

    local Accent = Instance.new("Frame", Badge)
    Accent.Size = UDim2.new(0, 6, 1, 0)
    Accent.BackgroundColor3 = isSuccess and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 50, 50)
    Accent.BorderSizePixel = 0
    Instance.new("UICorner", Accent).CornerRadius = UDim.new(0, 6)

    local Title = Instance.new("TextLabel", Badge)
    Title.Size = UDim2.new(1, -20, 1, 0)
    Title.Position = UDim2.new(0, 15, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = tostring(titleText)
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 14
    Title.TextXAlignment = Enum.TextXAlignment.Left

    TweenService:Create(Badge, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(1, -270, 1, -80)}):Play()
    task.delay(3, function()
        if not Badge or not Badge.Parent then return end
        local outTween = TweenService:Create(Badge, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 20, 1, -80)})
        outTween:Play()
        outTween.Completed:Connect(function()
            if Badge then Badge:Destroy() end
        end)
    end)
end


-- Verify Action
VerifyBtn.MouseButton1Click:Connect(function()
    if closed then return end
    local enteredKey = tostring(KeyBox.Text or "")

    if enteredKey == CORRECT_KEY then
        ShowBadge("Key Verified! Loading PainHub...", true)

        closed = true
        local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        })
        closeTween:Play()
        closeTween.Completed:Connect(function()
            if ScreenGui then ScreenGui:Destroy() end

            if not loadstring then
                ShowBadge("Executor missing loadstring", false)
                return
            end

            -- Fetch the script text first safely
            local scriptText = SafeFetch(REAL_URL)
            if not scriptText then
                warn("PaintHub: Failed to fetch script from URL. HttpGet nil or blocked.")
                return
            end

            -- Now load and execute it safely
            local func, err = loadstring(scriptText)
            if func then
                local ok, runErr = pcall(func)
                if not ok then 
                    warn("PaintHub runtime error: " .. tostring(runErr)) 
                end
            else
                warn("PaintHub syntax error in fetched script: " .. tostring(err))
            end
        end)
    else
        ShowBadge("Invalid Key! Join Discord.", false)
        KeyBox.Text = ""
    end
end)

